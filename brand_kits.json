    "what": "Brand kits for b-roll reels (the words on treatment clips). Rebuilt 2026-10-11 to Frances's brief: clean and natural, like text added in Instagram itself. No sound effects, no bounces or leans, footage as filmed. Talking heads use the brand packs in packs.py instead (signed off).",
    "fonts": "headings: the main words; captions: the call to action",
    "text_style": "the kit's usual layout: plain (words straight on the video, soft shadow) or ribbon (each line on its own highlight strip, like Instagram's text background). Each month mixes both.",
    "popup": "the kit's usual call to action: plain (just the words) or box (a clean box). Each month mixes both.",
    "colours": {
      "text": "words straight on the video",
      "highlight": "the one word in CAPITALS, when the words are straight on the video",
      "strip": "the highlight strips",
      "strip_text": "words on the strips",
      "popup_box": "the call-to-action box",
      "popup_text": "call-to-action words",
      "soft": "backgrounds for carousels and static posts (later)",
      "strip_highlight": "the one word in CAPITALS, on the highlight strips"
    },
    "own colours": "any kit can take a clinic's own colour palette instead (my_colours), keeping every pairing readable"
  },
